# Copy to .env in the repo root. Bun loads it at startup and the Python helpers
# inherit it. Every value is optional; the default is shown after each name.

# Music library the app scans and downloads into. Default: ~/Music/tracks
DJ_LIBRARY_ROOT=
# rekordbox app data folder holding master.db and share/. Default: ~/AppData/Roaming/Pioneer/rekordbox
# Under WSL point it at the Windows profile, e.g. /mnt/c/Users/<you>/AppData/Roaming/Pioneer/rekordbox
DJ_REKORDBOX_DIR=
# rekordbox.exe, reopened after an apply. Default: C:\Program Files\rekordbox\rekordbox 7.2.14\rekordbox.exe
DJ_REKORDBOX_EXE=
# App state: library.db, snapshots, art cache, openrouter.json. Default: ./data
DJ_DATA_DIR=
# Where scripts/apply-rekordbox.py copies master.db before writing. Default: $DJ_DATA_DIR/backups
DJ_BACKUP_DIR=

# Downloads
DJ_YTDLP=            # yt-dlp binary. Default: yt-dlp on PATH
DJ_NODE=             # node used by yt-dlp for YouTube's JS challenge. Default: node on PATH
DJ_YTM_COOKIES=      # Netscape cookie jar exported from your own signed-in browser. Default: $DJ_DATA_DIR/cookies/ytm-premium.txt

# YouTube Music
DJ_YTM_SEED_PLAYLIST=   # id of any public playlist you own; its channel is the one discovered
DJ_SYNC_URL=            # deployed worker/ URL for POST /api/ytm/pull
DJ_SYNC_TOKEN=          # bearer token, same value as the Worker's SYNC_TOKEN secret

# Playlist policy, comma-separated playlist names. Default: none
DJ_MANUAL_PLAYLISTS=                     # hand-curated; dedupe never writes into them
DJ_SYNC_EXCLUDED_PLAYLISTS=              # never pulled or staged by sync
DJ_AUTO_MEMBERSHIP_EXCLUDED_PLAYLISTS=   # never receive automatic memberships

OPENROUTER_API_KEY=   # optional, for AI set suggestions; can also be saved from the UI
PORT=8765
